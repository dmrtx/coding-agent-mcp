# ==============================================================================
# OpenAI Secure MCP Tunnel — Credenciales de Control Plane
# ==============================================================================

# 1. Tu Tunnel ID creado en OpenAI Platform:
# https://platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID="tunnel_..."

# 2. Tu Runtime API Key creada en OpenAI Platform:
# https://platform.openai.com/settings/organization/api-keys
# (Debe tener permisos de Tunnels Read + Use)
CONTROL_PLANE_API_KEY="sk-..."

# 3. (Opcional) Ruta al archivo config.yaml de coding-agent-mcp (por defecto ~/.coding-agent-mcp/config.yaml)
CODING_AGENT_CONFIG="$HOME/.coding-agent-mcp/config.yaml"
